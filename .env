# Committed on purpose (see README -> Quick Start). DATABASE_URL / JWT_SECRET / ENCRYPTION_KEY /
# DB_APP_PASSWORD below are local-dev-only values, not meant to protect anything outside your own
# docker-compose stack — regenerate them (e.g. `openssl rand -hex 32`) for any other use. The
# Jira/OpenAI fields are real secrets and are left blank; fill them in yourself.

DATABASE_URL=postgresql://identityhub:identityhub@postgres:5432/identityhub
JWT_SECRET=8d5562b9d38da38694fb22fb29fcbe6be1d0f5be3f88d8d9a524c6903c7dc36d
ENCRYPTION_KEY=c598f82c66f32f70a51d20354a37d2b9baf0d21d56b2ba01e1aaab35b19eb331

# Least-privilege runtime DB role (RLS-scoped, see README -> Database Schema). Migrations/seed use
# DATABASE_URL above (the owning role); only the running app connects as this one.
DB_APP_PASSWORD=a65bab966d9d750e322d8cc836886998
APP_DATABASE_URL=postgresql://identityhub_app:a65bab966d9d750e322d8cc836886998@postgres:5432/identityhub

# Jira OAuth — register a free OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps/
# (callback URL http://localhost:3000/api/jira/callback, scopes read:jira-work write:jira-work
# read:jira-user offline_access), then fill these in and restart (docker compose restart backend).
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3000/api/jira/callback

# Bonus: NHI Blog Digest (optional — falls back to a non-AI excerpt if omitted)
OPENAI_API_KEY=

PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
